{
  "name": "theblackmoney",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "mobile"
  ],
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"npm run dev -w apps/api\" \"npm run dev -w mobile\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w mobile",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
